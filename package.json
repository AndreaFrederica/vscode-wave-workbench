{
  "name": "wave-workbench",
  "displayName": "Wave Workbench — Verilator Waveforms & RTL Debugging",
  "version": "0.9.33",
  "publisher": "andreafrederica",
  "description": "Debug Verilator FST and VCD in VS Code with elaborated RTL hierarchy, waveform projects, Tcl and MCP. Supports Verdi FSDB and KDB.",
  "license": "MPL-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onCustomEditor:waveWorkbench.viewer",
    "onStartupFinished",
    "onWebviewPanel:waveWorkbench.schematic",
    "onWebviewPanel:waveWorkbench.moduleSchematic",
    "onView:waveWorkbench.control"
  ],
  "extensionPack": [
    "pascal-lab.vide-code-extension"
  ],
  "contributes": {
    "breakpoints": [
      {
        "language": "verilog"
      },
      {
        "language": "systemverilog"
      }
    ],
    "debuggers": [
      {
        "type": "wave-workbench-live",
        "label": "Wave Workbench RTL",
        "languages": [
          "verilog",
          "systemverilog"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to a live Verilator harness or VCS simv."
              },
              "cwd": {
                "type": "string",
                "description": "Simulation working directory.",
                "default": "${workspaceFolder}"
              },
              "backend": {
                "enum": [
                  "harness",
                  "vcs"
                ],
                "default": "harness"
              },
              "clock": {
                "type": "string",
                "description": "Sampled one-bit signal for rising-edge stepping. When omitted, step one simulator slot."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true
              },
              "plusargs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stimulusFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "signals": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Sampled hierarchical paths for VCS."
              },
              "statementScopes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "VCS instance paths for statement-entry events."
              },
              "recording": {
                "type": "string",
                "description": "Optional VCS output recording path."
              },
              "executionLog": {
                "type": "string",
                "description": "Execution recording from the matching build for source breakpoints."
              }
            }
          },
          "attach": {
            "properties": {
              "clock": {
                "type": "string",
                "description": "Sampled one-bit signal for rising-edge stepping."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true
              },
              "executionLog": {
                "type": "string",
                "description": "Execution recording from the matching build for source breakpoints."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "RTL: Attach to live simulation",
            "type": "wave-workbench-live",
            "request": "attach"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Wave Workbench RTL: Launch live harness",
            "description": "Start an instrumented Verilator harness or VCS simv.",
            "body": {
              "name": "RTL: Launch live harness",
              "type": "wave-workbench-live",
              "request": "launch",
              "program": "${workspaceFolder}/obj_dir/Vtestbench",
              "cwd": "${workspaceFolder}",
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "waveWorkbench.open",
        "title": "Wave Workbench: Open FSDB / FST / VCD",
        "icon": "$(pulse)"
      },
      {
        "command": "waveWorkbench.addSelection",
        "title": "Wave Workbench: Add Selected RTL Signals to Wave",
        "icon": "$(add)"
      },
      {
        "command": "waveWorkbench.videStatus",
        "title": "Wave Workbench: Show Vide Integration"
      },
      {
        "command": "waveWorkbench.traceDrivers",
        "title": "Wave Workbench: Trace Drivers from RTL Cursor"
      },
      {
        "command": "waveWorkbench.traceLoads",
        "title": "Wave Workbench: Trace Loads from RTL Cursor"
      },
      {
        "command": "waveWorkbench.traceWaveDrivers",
        "title": "%command.traceWaveDrivers%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "waveWorkbench.traceWaveLoads",
        "title": "%command.traceWaveLoads%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "waveWorkbench.traceWaveAtCursor",
        "title": "%command.traceWaveAtCursor%",
        "icon": "$(target)"
      },
      {
        "command": "waveWorkbench.openTraceSchematic",
        "title": "%command.openTraceSchematic%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "waveWorkbench.previewVideProject",
        "title": "Wave Workbench: Preview VIDE Project from Simulation Filelist"
      },
      {
        "command": "waveWorkbench.useVideProject",
        "title": "Wave Workbench: Set Simulation Filelist for Active Waveform Trace"
      },
      {
        "command": "waveWorkbench.startLiveTrace",
        "title": "Wave Workbench: Start Live Trace Harness"
      },
      {
        "command": "waveWorkbench.startVcsLiveTrace",
        "title": "Wave Workbench: Start VCS Live Trace"
      },
      {
        "command": "waveWorkbench.openExecutionRecording",
        "title": "Wave Workbench: Open Execution Recording"
      },
      {
        "command": "waveWorkbench.showLiveWave",
        "title": "%command.showLiveWave%"
      },
      {
        "command": "waveWorkbench.debugLiveTrace",
        "title": "Wave Workbench: Attach VS Code Debugger to Live RTL"
      },
      {
        "command": "waveWorkbench.controlLiveTrace",
        "title": "Wave Workbench: Control Live Trace"
      },
      {
        "command": "waveWorkbench.traceLiveSignal",
        "title": "Wave Workbench: Trace Live Signal"
      },
      {
        "command": "waveWorkbench.traceLiveContinuations",
        "title": "Wave Workbench: Trace Live Signal with Continuations"
      },
      {
        "command": "waveWorkbench.traceAddSignal",
        "title": "%command.traceAddSignal%",
        "icon": "$(add)"
      },
      {
        "command": "waveWorkbench.traceOpenNodeSource",
        "title": "%command.traceOpenNodeSource%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "waveWorkbench.traceCopySignal",
        "title": "Copy Trace Signal Path"
      },
      {
        "command": "waveWorkbench.traceFromSignal",
        "title": "Continue Trace from This Signal"
      },
      {
        "command": "waveWorkbench.openModuleSchematic",
        "title": "Wave Workbench: Open RTL Module Schematic"
      },
      {
        "command": "waveWorkbench.attachKdb",
        "title": "Wave Workbench: Attach Design Database (KDB / Verilator JSON)"
      },
      {
        "command": "waveWorkbench.openPicker",
        "title": "%command.openPicker%",
        "icon": "$(folder-open)"
      },
      {
        "command": "waveWorkbench.openLast",
        "title": "%command.openLast%",
        "icon": "$(history)"
      },
      {
        "command": "waveWorkbench.openRecent",
        "title": "%command.openRecent%",
        "icon": "$(history)"
      },
      {
        "command": "waveWorkbench.runTcl",
        "title": "%command.runTcl%",
        "icon": "$(terminal)"
      },
      {
        "command": "waveWorkbench.runScript",
        "title": "%command.runScript%",
        "icon": "$(play)"
      },
      {
        "command": "waveWorkbench.fit",
        "title": "Wave Workbench: nWave: Zoom All",
        "icon": "$(screen-full)"
      },
      {
        "command": "waveWorkbench.zoomIn",
        "title": "Wave Workbench: nWave: Zoom In",
        "icon": "$(zoom-in)"
      },
      {
        "command": "waveWorkbench.zoomOut",
        "title": "Wave Workbench: nWave: Zoom Out",
        "icon": "$(zoom-out)"
      },
      {
        "command": "waveWorkbench.nextEdge",
        "title": "Wave Workbench: nWave: Next Transition",
        "icon": "$(arrow-right)"
      },
      {
        "command": "waveWorkbench.previousEdge",
        "title": "Wave Workbench: nWave: Previous Transition",
        "icon": "$(arrow-left)"
      },
      {
        "command": "waveWorkbench.setCursor",
        "title": "Wave Workbench: nWave: Set Cursor…",
        "icon": "$(location)"
      },
      {
        "command": "waveWorkbench.setMarker",
        "title": "Wave Workbench: nWave: Set Marker…",
        "icon": "$(bookmark)"
      },
      {
        "command": "waveWorkbench.saveSignals",
        "title": "Wave Workbench: nWave: Save Signals…",
        "icon": "$(save)"
      },
      {
        "command": "waveWorkbench.restoreSignals",
        "title": "Wave Workbench: nWave: Restore Signals…",
        "icon": "$(folder-open)"
      },
      {
        "command": "waveWorkbench.cacheStats",
        "title": "%command.cacheStats%",
        "icon": "$(database)"
      },
      {
        "command": "waveWorkbench.showSidebar",
        "title": "%command.showSidebar%",
        "icon": "$(layout-sidebar)"
      },
      {
        "command": "waveWorkbench.debugLayout",
        "title": "%command.debugLayout%",
        "icon": "$(layout)"
      },
      {
        "command": "waveWorkbench.dockWave",
        "title": "%command.dockWave%"
      },
      {
        "command": "waveWorkbench.showTclConsole",
        "title": "%command.showTclConsole%"
      },
      {
        "command": "waveWorkbench.showPanelTrace",
        "title": "%command.showPanelTrace%"
      },
      {
        "command": "waveWorkbench.configureLayout",
        "title": "%command.configureLayout%"
      },
      {
        "command": "waveWorkbench.saveProject",
        "title": "%command.saveProject%"
      },
      {
        "command": "waveWorkbench.openProject",
        "title": "%command.openProject%"
      },
      {
        "command": "waveWorkbench.exportClip",
        "title": "%command.exportClip%"
      },
      {
        "command": "waveWorkbench.selectBackend",
        "title": "%command.selectBackend%",
        "icon": "$(server-process)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "waveWorkbench.addSelection",
          "when": "editorLangId == systemverilog || editorLangId == verilog",
          "group": "navigation@90"
        }
      ],
      "explorer/context": [
        {
          "command": "waveWorkbench.open",
          "when": "resourceExtname == .fsdb || resourceExtname == .fst || resourceExtname == .vcd || resourceExtname == .wdb || resourceExtname == .wlf || resourceExtname == .raw || resourceExtname == .psfascii || resourceExtname == .tran || resourceFilename =~ /\\.tran\\.dat$/i || resourceExtname == .dsn || resourceExtname == .trn || resourceExtname == .psfxl || resourceExtname == .shm || resourceExtname == .psfbin || resourceExtname == .psf || resourceExtname == .ac || resourceExtname == .dc || resourceExtname == .noise || resourceExtname == .info || resourceExtname == .pz || resourceExtname == .xf || resourceExtname == .stb || resourceExtname == .sparam || resourceExtname == .sp || resourceExtname == .sweep",
          "group": "navigation"
        },
        {
          "command": "waveWorkbench.runScript",
          "when": "resourceExtname == .tcl || resourceExtname == .rc",
          "group": "navigation@91"
        },
        {
          "command": "waveWorkbench.openProject",
          "when": "resourceExtname == .waveproj"
        }
      ],
      "editor/title": [
        {
          "command": "waveWorkbench.open",
          "group": "navigation@1"
        },
        {
          "command": "waveWorkbench.runTcl",
          "when": "activeCustomEditorId == waveWorkbench.viewer",
          "group": "navigation@2"
        },
        {
          "command": "waveWorkbench.selectBackend",
          "when": "activeCustomEditorId == waveWorkbench.viewer && (resourceExtname =~ /^(\\.fsdb|\\.shm|\\.dsn|\\.trn|\\.psfxl|\\.tran)$/i || resourceFilename =~ /\\.tran\\.dat$/i)",
          "group": "navigation@4"
        },
        {
          "command": "waveWorkbench.addSelection",
          "when": "editorLangId == systemverilog || editorLangId == verilog",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "waveWorkbench.traceOpenNodeSource",
          "when": "(view == waveWorkbench.traceExplorer || view == waveWorkbench.panelTrace) && viewItem =~ /traceSource/",
          "group": "navigation@1"
        },
        {
          "command": "waveWorkbench.traceAddSignal",
          "when": "(view == waveWorkbench.traceExplorer || view == waveWorkbench.panelTrace) && viewItem =~ /traceSignal.*traceWaveform/",
          "group": "inline"
        },
        {
          "command": "waveWorkbench.traceAddSignal",
          "when": "(view == waveWorkbench.traceExplorer || view == waveWorkbench.panelTrace) && viewItem =~ /traceWaveform/",
          "group": "navigation@2"
        },
        {
          "command": "waveWorkbench.traceCopySignal",
          "when": "(view == waveWorkbench.traceExplorer || view == waveWorkbench.panelTrace) && viewItem =~ /traceSignal/"
        },
        {
          "command": "waveWorkbench.traceFromSignal",
          "when": "(view == waveWorkbench.traceExplorer || view == waveWorkbench.panelTrace) && viewItem =~ /traceSignal|traceTemporalFrontier/"
        }
      ],
      "view/title": [
        {
          "command": "waveWorkbench.traceWaveDrivers",
          "when": "view == waveWorkbench.traceExplorer || view == waveWorkbench.panelTrace",
          "group": "navigation@1"
        },
        {
          "command": "waveWorkbench.traceWaveLoads",
          "when": "view == waveWorkbench.traceExplorer || view == waveWorkbench.panelTrace",
          "group": "navigation@2"
        },
        {
          "command": "waveWorkbench.traceWaveAtCursor",
          "when": "view == waveWorkbench.traceExplorer || view == waveWorkbench.panelTrace",
          "group": "navigation@3"
        },
        {
          "command": "waveWorkbench.openTraceSchematic",
          "when": "view == waveWorkbench.traceExplorer || view == waveWorkbench.panelTrace",
          "group": "navigation@4"
        },
        {
          "command": "waveWorkbench.open",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@1"
        },
        {
          "command": "waveWorkbench.open",
          "when": "view == waveWorkbench.control",
          "group": "navigation@1"
        },
        {
          "command": "waveWorkbench.selectBackend",
          "when": "view == waveWorkbench.control",
          "group": "navigation@2"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "waveWorkbench.viewer",
        "displayName": "Wave Workbench",
        "selector": [
          {
            "filenamePattern": "*.fsdb"
          },
          {
            "filenamePattern": "*.vcd"
          },
          {
            "filenamePattern": "*.fst"
          },
          {
            "filenamePattern": "**/*.shm/*.dsn"
          },
          {
            "filenamePattern": "**/*.shm/*.trn"
          },
          {
            "filenamePattern": "*.psfxl"
          },
          {
            "filenamePattern": "*.tran.dat"
          },
          {
            "filenamePattern": "*.psfbin"
          },
          {
            "filenamePattern": "*.psf"
          },
          {
            "filenamePattern": "*.ac"
          },
          {
            "filenamePattern": "*.dc"
          },
          {
            "filenamePattern": "*.noise"
          },
          {
            "filenamePattern": "*.info"
          },
          {
            "filenamePattern": "*.pz"
          },
          {
            "filenamePattern": "*.xf"
          },
          {
            "filenamePattern": "*.stb"
          },
          {
            "filenamePattern": "*.sparam"
          },
          {
            "filenamePattern": "*.sweep"
          },
          {
            "filenamePattern": "*.sp"
          },
          {
            "filenamePattern": "*.wdb"
          },
          {
            "filenamePattern": "*.wlf"
          },
          {
            "filenamePattern": "*.raw"
          },
          {
            "filenamePattern": "*.psfascii"
          },
          {
            "filenamePattern": "*.tran"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Wave Workbench",
      "properties": {
        "waveWorkbench.autoSplit": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "%setting.autoSplit%"
        },
        "waveWorkbench.xceliumHome": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Xcelium installation on the extension host for SHM (Linux x64). Falls back to XCELIUM_HOME."
        },
        "waveWorkbench.vivadoHome": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Vivado installation on the extension host for WDB (Linux x64). Falls back to XILINX_VIVADO."
        },
        "waveWorkbench.wlf2vcdPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Installed Questa wlf2vcd executable for WLF import."
        },
        "waveWorkbench.backendPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Native wave-backend executable; empty uses bundled binary."
        },
        "waveWorkbench.independentBackendPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Custom executable for the independent FSDB and KDB backend. Empty uses the bundled Rust implementation when Independent is selected."
        },
        "waveWorkbench.fsdbBackend": {
          "type": "string",
          "scope": "resource",
          "default": "auto",
          "enum": [
            "auto",
            "independent",
            "verdi"
          ],
          "enumDescriptions": [
            "Prefer a configured Verdi backend. Fall back to WaveBench Reader if Verdi cannot open the file.",
            "Read FSDB and KDB with the independent backend.",
            "Read FSDB and KDB with Verdi Reader and NPI."
          ],
          "description": "Backend for FSDB waveforms and their paired KDB databases."
        },
        "waveWorkbench.shmBackend": {
          "type": "string",
          "scope": "resource",
          "default": "auto",
          "enum": ["auto", "independent", "cadence"],
          "enumDescriptions": [
            "Prefer direct Rust reads. Try Cadence when the SHM or PSFXL waveform cannot be opened.",
            "Read SHM and PSFXL directly using Rust.",
            "Use the installed Cadence waveform tools on Linux x64."
          ],
          "description": "Backend for SHM databases and PSFXL transient waveforms."
        },
        "waveWorkbench.verdiHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Verdi installation containing share/FsdbReader/linux64. Defaults to VERDI_HOME or NOVAS_HOME."
        },
        "waveWorkbench.eventsPerSignal": {
          "type": "integer",
          "default": 20000,
          "minimum": 100,
          "maximum": 100000,
          "description": "Maximum events returned per signal/window. Zoom in when truncated."
        },
        "waveWorkbench.kdbPath": {
          "type": "string",
          "default": "",
          "description": "Matching VCS simv.daidir or its simv.kdb. Empty automatically checks beside the waveform."
        },
        "waveWorkbench.verilatorTreePath": {
          "type": "string",
          "default": "",
          "description": "Path to Verilator's elaborated .tree.json, relative to the workspace or absolute. Keep the companion .tree.meta.json beside it. Leave empty to detect a matching file beside the VCD or FST."
        },
        "waveWorkbench.sourcePathMappings": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Design database source path prefix replacements for relocated RTL."
        },
        "waveWorkbench.hierarchyMappings": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Waveform hierarchy prefix to design database hierarchy prefix replacements."
        },
        "waveWorkbench.defaultWaveform": {
          "type": "string",
          "default": "",
          "description": "One-click open target. Empty reopens the last waveform in this workspace; otherwise opens a file picker. Relative to workspace root."
        },
        "waveWorkbench.tclshPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Override the Tcl 8.6+ interpreter. Empty prefers the bundled Tcl and falls back to tclsh on PATH."
        },
        "waveWorkbench.cacheSizeMB": {
          "type": "integer",
          "default": 128,
          "minimum": 0,
          "maximum": 1048576,
          "description": "%setting.cacheSizeMB%"
        },
        "waveWorkbench.psfxlMemoryCacheSizeMB": {
          "type": "integer",
          "default": 64,
          "minimum": 0,
          "maximum": 1048576,
          "description": "%setting.psfxlMemoryCacheSizeMB%"
        },
        "waveWorkbench.psfxlCacheSizeMB": {
          "type": "integer",
          "default": 768,
          "minimum": 0,
          "maximum": 1048576,
          "description": "%setting.psfxlCacheSizeMB%"
        },
        "waveWorkbench.mcpEnabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "%setting.mcpEnabled%"
        },
        "waveWorkbench.lzoLibraryPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to an LZO 2 shared library for the independent FSDB and KDB backend. Empty uses the system installation."
        }
      }
    },
    "keybindings": [
      {
        "command": "waveWorkbench.open",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w"
      },
      {
        "command": "waveWorkbench.addSelection",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && (editorLangId == systemverilog || editorLangId == verilog)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "waveWorkbenchWavePanel",
          "title": "%container.waveWorkbenchWavePanel%",
          "icon": "media/activity-wave.svg"
        },
        {
          "id": "waveWorkbenchTclPanel",
          "title": "%container.waveWorkbenchTclPanel%",
          "icon": "media/activity-wave.svg"
        },
        {
          "id": "waveWorkbenchTracePanel",
          "title": "%container.waveWorkbenchTracePanel%",
          "icon": "media/activity-wave.svg"
        },
        {
          "id": "waveWorkbenchLive",
          "title": "%container.waveWorkbenchLive%",
          "icon": "media/activity-wave.svg"
        }
      ],
      "activitybar": [
        {
          "id": "waveWorkbench",
          "title": "Wave Workbench",
          "icon": "media/activity-wave.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "waveWorkbench.traceExplorer",
        "contents": "%trace.welcome%"
      }
    ],
    "views": {
      "waveWorkbenchWavePanel": [
        {
          "type": "webview",
          "id": "waveWorkbench.panelWave",
          "name": "%view.waveWorkbench.panelWave%"
        }
      ],
      "waveWorkbenchTclPanel": [
        {
          "type": "webview",
          "id": "waveWorkbench.panelTcl",
          "name": "%view.waveWorkbench.panelTcl%"
        }
      ],
      "waveWorkbenchTracePanel": [
        {
          "id": "waveWorkbench.panelTrace",
          "name": "%view.waveWorkbench.panelTrace%"
        }
      ],
      "waveWorkbenchLive": [
        {
          "type": "webview",
          "id": "waveWorkbench.liveWave",
          "name": "%view.waveWorkbench.liveWave%",
          "icon": "media/activity-wave.svg"
        }
      ],
      "waveWorkbench": [
        {
          "type": "webview",
          "id": "waveWorkbench.control",
          "name": "%view.waveWorkbench.control%",
          "contextualTitle": "Wave Workbench"
        },
        {
          "id": "waveWorkbench.traceExplorer",
          "name": "RTL Trace"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.webview.json",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "pretest": "npm run typecheck && npm run build",
    "bench:decoders": "npm run build && node benchmarks/decoders/run.mjs",
    "test:ui": "npm run typecheck && npm run build && playwright test",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.mjs\" \"type-tests/*.ts\" \"tsconfig*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/*.mjs\" \"type-tests/*.ts\" \"tsconfig*.json\"",
    "package:native": "node scripts/package-native.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
